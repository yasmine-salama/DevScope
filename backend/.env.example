# Generate a strong secret with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# SQLite database created locally under backend/instance/
DATABASE_URL=sqlite:///devscope.db

# Optional: improves GitHub API rate limits. Never commit a real token.
GITHUB_TOKEN=

# Set true only behind HTTPS in production.
SESSION_COOKIE_SECURE=false
